---
/**
 * 最小化的頁面外殼。
 *
 * lang 屬性是整個樣式體系的開關 —— tokens.css 的語言隔離層透過 :lang()
 * 讀取它來切換行高、字距、內文寬度與段距。預設為 zh-Hant。
 *
 * Phase 2 的 DocLayout 會建構在這之上。
 */
import "../styles/index.css";

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description, lang = "zh-Hant" } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
