---
/**
 * 本頁目錄。
 *
 * 資料來自 render() 在 build 期回傳的 headings，client 端不掃描 DOM。
 * 目前是純靜態的錨點清單，零 JavaScript。
 *
 * 目前位置高亮（scroll spy）需要 IntersectionObserver，
 * 將在 Phase 4 的效能閘門建立之後，以獨立的 <toc-highlight>
 * Web Component 加上（client:idle）—— 見 docs/todo.md。
 */
import type { TocNode } from "../utils/toc";

interface Props {
  nodes: TocNode[];
  depth?: number;
}

const { nodes, depth = 0 } = Astro.props;
---

{
  depth === 0 ? (
    <aside class="doc-toc" aria-label="本頁目錄">
      <p class="toc-title">本頁內容</p>
      <ul class="toc-list" data-depth={depth}>
        {nodes.map((node) => (
          <li>
            <a class="toc-link" href={`#${node.slug}`}>
              {node.text}
            </a>
            {node.children.length > 0 && (
              <Astro.self nodes={node.children} depth={depth + 1} />
            )}
          </li>
        ))}
      </ul>
    </aside>
  ) : (
    <ul class="toc-list" data-depth={depth}>
      {nodes.map((node) => (
        <li>
          <a class="toc-link" href={`#${node.slug}`}>
            {node.text}
          </a>
          {node.children.length > 0 && (
            <Astro.self nodes={node.children} depth={depth + 1} />
          )}
        </li>
      ))}
    </ul>
  )
}

<style>
  @layer components {
    .toc-title {
      margin-block-end: var(--space-3);
      font-size: var(--text-xs);
      font-weight: var(--weight-bold);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--color-text-subtle);
    }

    .toc-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1px;
    }

    .toc-list:not([data-depth="0"]) {
      margin-inline-start: var(--space-3);
    }

    .toc-link {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      padding: var(--space-1) var(--space-2);
      border-radius: var(--radius-1);
      font-size: var(--text-xs);
      line-height: var(--leading-tight);
      color: var(--color-text-muted);
      text-decoration: none;
    }

    .toc-link:hover {
      background: var(--color-surface);
      color: var(--color-text);
    }

    .toc-list:not([data-depth="0"]) .toc-link {
      color: var(--color-text-subtle);
    }
  }
</style>
