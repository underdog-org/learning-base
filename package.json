{
  "name": "learning-base",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pnpm search:index && node scripts/perf-budget.mjs",
    "search:index": "pagefind --site dist && node scripts/prune-search-bundle.mjs",
    "perf": "node scripts/perf-budget.mjs",
    "preview": "pnpm --filter learning-base... run build && wrangler dev",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "pnpm --filter learning-base... run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.5",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.4",
    "astro": "^7.1.4",
    "astro-expressive-code": "^0.44.1",
    "rehype-autolink-headings": "^7.1.0",
    "remark-cjk-friendly": "^2.3.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
    "pagefind": "^1.5.2"
  }
}
